# ── Build output & dependencies ────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors & OS ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Figma Make platform files ─────────────────────────────────────────────
# Generated by Figma Make. vite.config.ts loads it when present and skips the
# Figma plugins when it is absent, so a local checkout builds without it.
.figma/

# ── Private source material — do NOT publish ──────────────────────────────
# Raw career documents: superseded résumés, the source .docx, and the working
# images pulled out of them. If this repository is public, committing these
# would expose every previous version of the CV.
#
# The CV the site actually serves is src/assets/cv.pdf, bundled by the
# Download CV button. That one stays tracked.
private/

# ── Generated from certificates/ ──────────────────────────────────────────
# Certificate scans are authored in certificates/ and copied here by
# scripts/sync-certificates.mjs on every dev and build run. Tracked input, one
# location; this folder is output and would only be a second source of truth.
public/certs/
